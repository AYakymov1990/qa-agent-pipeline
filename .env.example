# Скопіюйте у .env і заповніть. .env не комітиться. Паролі — тільки тут.

# Хто запускає — для назви папки прогону (латиницею, напр. o.yakymov)
QA_USER=

# Локальні шляхи до репозиторіїв (тільки читання)
AVTOPRO_PATH=/Users/<you>/Desktop/ABP/avto/AvtoPro
CODEWIKI_PATH=/Users/<you>/Desktop/ABP/avto/CodeWiki/CodeWiki
AUTOMATION_PATH=/Users/<you>/Desktop/ABP/avto/AvtoProAutomation

# Тестовий стенд за замовчуванням (можна перевизначити в команді: /dev-check <ID> seller3 es)
TEST_STAND=seller1
TEST_SITE=es
# Доступ до закритого стенду (cookie TestEnvAccessToken, 7 днів)
TEST_ENV_PASSWORD=

# Тестові акаунти — ТІЛЬКИ користувачі зі StaticUserHelper.TestUsers.
# Назви змінних — ті самі, що в довіднику тестових даних CodeWiki (kb/QA/test-data.md, ID TD-…).
TEST_BUYER_ES_LOGIN=
TEST_BUYER_ES_PASSWORD=
TEST_SELLER_ES_LOGIN=
TEST_SELLER_ES_PASSWORD=

# Azure DevOps PAT — тільки якщо MCP не може завантажити вкладення (scripts/ado_attachment.py).
# Права: Work Items (Read). Не комітити.
ADO_PAT=

# Частка підписки в метриках прогону ($ на місяць)
QA_SUBSCRIPTION_USD=120
